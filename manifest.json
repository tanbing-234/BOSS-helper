{
  "manifest_version": 3,
  "name": "BOSS 求职助手",
  "version": "1.7.0",
  "description": "根据个人简历筛选 BOSS 直聘岗位，并生成定制化招呼语。",
  "permissions": ["storage", "sidePanel", "tabs", "activeTab", "scripting", "alarms"],
  "host_permissions": ["https://www.zhipin.com/*", "http://localhost/*", "http://127.0.0.1/*", "https://*/*"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "打开 BOSS 求职助手"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://www.zhipin.com/*",
        "https://www.zhaopin.com/*",
        "https://sou.zhaopin.com/*",
        "https://jobs.zhaopin.com/*"
      ],
      "js": ["src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ]
}
